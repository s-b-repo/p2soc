# SOC video-wall kiosk session — generated by setup.py.
# Non-secret config is baked in as Environment= below (no soc.env).
# The vault master is sealed host-bound under $SOC_SECRET_DIR.
[Unit]
Description=SOC video-wall kiosk session
After=systemd-user-sessions.service network-online.target vaultwarden.service
Wants=network-online.target vaultwarden.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user

Environment=SOC_VAULT_BACKEND=rbw
Environment=SOC_VAULT_EMAIL=k@soc.local
Environment=SOC_VAULT_URL=http://127.0.0.1:8222
Environment=SOC_SECRET_DIR=/etc/soc-display/secret
Environment=SOC_MASTER_SOURCE=sealed
Environment="SOC_SECRET_ATTRS=service=soc-wall account=vault-master"
Environment="SOC_CONFIG_VAULT_ITEM=SOC Wall Config"
Environment=SOC_ROOT=/opt/soc-display
Environment=SOC_PANELS_FILE=/etc/soc-display/panels.yaml
Environment=SOC_INJECT_TMPL=/opt/soc-display/inject/login.js.tmpl
Environment=SOC_LAUNCH_STAGGER=1.5
Environment=SOC_READY_TIMEOUT=120
Environment=SOC_CDP_BASE_PORT=9222
Environment=SOC_CRED_TTL=30
Environment=SOC_VPN_DRY_RUN=0
Environment=SOC_SESSION=auto
Environment=SOC_UNATTENDED=1
# Recycle a panel before the cgroup starts thrash-reclaiming.
Environment=SOC_MEM_MIN_AVAIL_MB=150
# Physical-access config surface: off by default, PIN mandatory if enabled.
Environment=SOC_ONSCREEN_CONFIG=0
Environment=SOC_CONFIG_REQUIRE_PIN=1

ExecStart=/srv/soc wall/scripts/start-session.sh
Restart=always
RestartSec=3
# MemoryHigh throttles a leaking dashboard through kernel reclaim. No hard
# MemoryMax on purpose: that OOM-kills inside the cgroup and blanks the WHOLE
# wall before the host's memory watchdog can recycle a single panel.
MemoryAccounting=yes
MemoryHigh=80%
LimitCORE=0
LimitNPROC=256
LimitNOFILE=8192
TasksMax=512
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical.target
