# SOC video-wall kiosk session — generated by setup.py.
# Non-secret config is baked in as Environment= below (no soc.env).
# The vault master is sealed host-bound under $SOC_SECRET_DIR.
[Unit]
Description=SOC video-wall kiosk session
After=systemd-user-sessions.service network-online.target vaultwarden.service
Wants=network-online.target vaultwarden.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=soc
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user

Environment=SOC_VAULT_BACKEND=
Environment=SOC_VAULT_EMAIL=a@b.c
Environment=SOC_VAULT_URL=
Environment=SOC_SECRET_DIR=
Environment=SOC_MASTER_SOURCE=
Environment=SOC_SECRET_ATTRS=
Environment=SOC_CONFIG_VAULT_ITEM=
Environment=SOC_ROOT=
Environment=SOC_PANELS_FILE=
Environment=SOC_INJECT_TMPL=
Environment=SOC_LAUNCH_STAGGER=
Environment=SOC_READY_TIMEOUT=
Environment=SOC_CDP_BASE_PORT=
Environment=SOC_CRED_TTL=
Environment=SOC_VPN_DRY_RUN=
Environment=SOC_SESSION=
Environment=SOC_UNATTENDED=
# Recycle a panel before the cgroup starts thrash-reclaiming.
Environment=SOC_MEM_MIN_AVAIL_MB=150
# Physical-access config surface: off by default, PIN mandatory if enabled.
Environment=SOC_ONSCREEN_CONFIG=0
Environment=SOC_CONFIG_REQUIRE_PIN=1

ExecStart=/opt/soc-display/scripts/start-session.sh
Restart=always
RestartSec=3
# MemoryHigh throttles a leaking dashboard through kernel reclaim. No hard
# MemoryMax on purpose: that OOM-kills inside the cgroup and blanks the WHOLE
# wall before the host's memory watchdog can recycle a single panel.
MemoryAccounting=yes
MemoryHigh=80%
LimitCORE=0
LimitNPROC=256
LimitNOFILE=8192
TasksMax=512
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
LockPersonality=yes
RestrictRealtime=yes

[Install]
WantedBy=graphical.target
