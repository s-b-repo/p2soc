# SOC kiosk environment — generated by setup.py. NON-SECRET.
# The vault master password is NOT here: it is sealed host-bound under
# $SOC_SECRET_DIR and fed to litebw by pinentry-vault.py (no .env secret).
# The wall config lives in Vaultwarden (SOC_CONFIG_VAULT_ITEM). See
# docs/SECURITY.md.

# --- vault (litebw -> Vaultwarden) ---
SOC_VAULT_BACKEND=rbw
SOC_VAULT_EMAIL=k@soc.local
SOC_VAULT_URL=http://127.0.0.1:8222
SOC_SECRET_DIR=/etc/soc-display/secret
SOC_CONFIG_VAULT_ITEM='SOC Wall Config'

# --- paths ---
SOC_ROOT=/opt/soc-display
SOC_PANELS_FILE=/etc/soc-display/panels.yaml
SOC_INJECT_TMPL=/opt/soc-display/inject/login.js.tmpl

# --- host tuning ---
SOC_LAUNCH_STAGGER=1.5
SOC_READY_TIMEOUT=120
SOC_CDP_BASE_PORT=9222
SOC_CRED_TTL=30
SOC_VPN_DRY_RUN=0
SOC_MEM_MIN_AVAIL_MB=150

# --- display stack: auto|wayland|xwayland|xlibre|xorg|x11 ---
SOC_SESSION=auto
