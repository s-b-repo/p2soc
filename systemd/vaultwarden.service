[Unit]
Description=Vaultwarden (Bitwarden-compatible) secrets vault for the SOC wall
Documentation=https://github.com/dani-garcia/vaultwarden
After=network-online.target
Wants=network-online.target

[Service]
User=vaultwarden
Group=vaultwarden
# Config is INLINE here — no .env file. All of it is non-secret: bound to
# localhost, signups off, websockets off. The /admin page is DISABLED (no
# ADMIN_TOKEN) because the kiosk does not need it.
#
# The first account is created by `setup.py deploy`, which opens signups through a
# transient drop-in for the length of that one call. They are otherwise always off.
# Enable /admin later the same way:  Environment=ADMIN_TOKEN=<vaultwarden hash>
Environment=DATA_FOLDER=/var/lib/vaultwarden
Environment=ROCKET_ADDRESS=127.0.0.1
Environment=ROCKET_PORT=8222
Environment=SIGNUPS_ALLOWED=false
Environment=SIGNUPS_VERIFY=false
Environment=WEBSOCKET_ENABLED=false
# Only the binary is installed (scripts/fetch-vaultwarden.py), so this must be off:
# with the web vault enabled and absent, Vaultwarden refuses to start. It also
# removes a whole web surface the kiosk never uses; accounts are created over the API.
Environment=WEB_VAULT_ENABLED=false
# A single local client: the defaults (10 workers, 10 connections) waste RAM here.
Environment=ROCKET_WORKERS=2
Environment=DATABASE_MAX_CONNS=2
Environment=LOG_LEVEL=warn
Environment=DISABLE_ICON_DOWNLOAD=true
ExecStart=/usr/local/bin/vaultwarden
WorkingDirectory=/var/lib/vaultwarden
StateDirectory=vaultwarden
Restart=always
RestartSec=5

# --- hardening -------------------------------------------------------------
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
ReadWritePaths=/var/lib/vaultwarden
# Vaultwarden listens on localhost only (ROCKET_ADDRESS=127.0.0.1 above).

[Install]
WantedBy=multi-user.target
