# Zero-touch redeploy settings: installed to /etc/soc-display/update.env.
# Read as plain KEY=VALUE data by scripts/soc-update.py; never sourced by a shell.
# See docs/AUTO_UPDATE.md.

# 0 turns redeploys and self-repair off for this box.
SOC_UPDATE_ENABLE=1

# Where releases come from. Must be https:// with no embedded credentials.
SOC_UPDATE_REPO=https://github.com/s-b-repo/p2soc.git

# What to follow. CI fast-forwards `stable` only after the test suite passes, so a
# broken push never reaches a wall. Until `stable` exists, the fallback is used.
SOC_UPDATE_REF=stable
SOC_UPDATE_FALLBACK_REF=main

# When a release may be applied, e.g. 03:00-05:00 local time (may wrap midnight).
# A restart blanks the wall for up to a minute. Empty means any time.
SOC_UPDATE_WINDOW=

# Redeploy the current commit if the deployed files are found to be damaged.
# Set to 0 if you hand-edit files under /opt/soc-display on purpose.
SOC_UPDATE_REPAIR=1

# Dead-man's switch: an https URL pinged after every healthy run, with /fail
# appended after a bad one. An external monitor (healthchecks.io or similar) then
# pages you if the box goes silent. Empty disables it.
SOC_HEALTHCHECK_URL=

# Signature enforcement: if the allowed-signers file below exists (ssh-keygen
# format), every deployed commit must carry a valid signature from a listed key.
# Strongly recommended: without it, anyone who can push to the tracked ref can
# run code as root on every wall. Installed by you; nothing creates it.
# SOC_UPDATE_SIGNERS=/etc/soc-display/update-signers
