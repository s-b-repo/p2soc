# Lets the SOC wall (running as user `soc`) restart specific services without a
# password, so the Settings tab's "Save" applies VPN / tunnel / tarpit changes
# live instead of queuing a "PENDING restart" message for an operator.
#
# Scope is intentionally MINIMAL: exactly three units. The host drives every VPN
# through the single forti-vpn.service, so no @-instances are needed.
#
# Every entry is an EXACT command line, on purpose: in sudoers `*` also matches
# spaces. `systemctl restart soc-vpn@*.service` would let a compromised renderer
# restart ANY unit by appending it, and `journalctl -u x *` would hand it every
# journalctl flag as root. The wall uses the two journalctl shapes below and nothing
# else (see host/vpn_log_viewer.py).
#
# Installed by install.sh to /etc/sudoers.d/soc-wall-restart, mode 0440, checked
# with visudo first so a syntax error can't break the whole sudoers stack.

soc ALL=(root) NOPASSWD: /usr/bin/systemctl restart forti-vpn.service, \
                         /usr/bin/systemctl restart autossh-tunnel.service, \
                         /usr/bin/systemctl restart soc-tarpit.service, \
                         /usr/bin/systemctl start   forti-vpn.service, \
                         /usr/bin/systemctl start   autossh-tunnel.service, \
                         /usr/bin/systemctl start   soc-tarpit.service, \
                         /usr/bin/systemctl stop    forti-vpn.service, \
                         /usr/bin/systemctl stop    autossh-tunnel.service, \
                         /usr/bin/systemctl stop    soc-tarpit.service, \
                         /usr/bin/systemctl enable  forti-vpn.service, \
                         /usr/bin/systemctl enable  autossh-tunnel.service, \
                         /usr/bin/systemctl enable  soc-tarpit.service, \
                         /usr/bin/systemctl disable forti-vpn.service, \
                         /usr/bin/systemctl disable autossh-tunnel.service, \
                         /usr/bin/systemctl disable soc-tarpit.service, \
                         /usr/bin/systemctl status  forti-vpn.service, \
                         /usr/bin/systemctl status  autossh-tunnel.service, \
                         /usr/bin/systemctl status  soc-tarpit.service, \
                         /usr/bin/journalctl -u forti-vpn.service -n 0 --no-pager, \
                         /usr/bin/journalctl -u forti-vpn.service -f --no-pager -n 100 -o cat
