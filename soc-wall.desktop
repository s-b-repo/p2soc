# SOC Video Wall control center — the single advertised entry point
# for the wall: run (desktop/kiosk), configure (setup/appearance), and system
# (install/uninstall) in one window. Opened from the desktop icon or app menu.
[Desktop Entry]
Name=SOC Video Wall
Comment=Open the SOC video-wall control center (run, configure, install/uninstall)
Exec=/opt/soc-display/scripts/soc-wall-menu
Icon=soc-wall
Terminal=false
Type=Application
Categories=System;
StartupNotify=true
Keywords=soc;security;wall;kiosk;dashboard
